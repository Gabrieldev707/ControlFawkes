# Backend
PORT=8100
HOST=0.0.0.0

# Frontend
VITE_WS_PORT=8100

# Inteligência local opcional. Sem modelo, o modo auto não faz chamadas.
# Nenhuma API externa, chave ou telemetria é usada.
CONTROLFAWKES_LOCAL_AI=auto
CONTROLFAWKES_OLLAMA_URL=http://127.0.0.1:11434
CONTROLFAWKES_OLLAMA_MODEL=
CONTROLFAWKES_OLLAMA_TIMEOUT=5

# Override opcional para apontar explicitamente para outro computador:
# VITE_WS_URL=ws://192.168.0.100:8100/ws
