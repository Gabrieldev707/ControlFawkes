{
  "manifest_version": 3,
  "name": "ControlFawkes Browser Media Bridge",
  "version": "0.1.0",
  "description": "Observa a mídia reproduzida no navegador e a entrega ao ControlFawkes.",
  "key": "",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "ControlFawkes Bridge"
  }
}
